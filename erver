datasource db {
  provider = "postgresql"  // PostgreSQL kullanıyoruz
  url      = env("DATABASE_URL") // .env dosyasındaki DATABASE_URL'yi alacak
}

generator client {
  provider = "prisma-client-js" // Prisma client kullanacağız
}

// Product modelini oluşturuyoruz (Ürünler tablosu)
model Product {
  id        Int      @id @default(autoincrement()) // Benzersiz ID
  name      String   // Ürün adı
  price     Float    // Ürün fiyatı
  stock     Int      // Ürün stoğu
  createdAt DateTime @default(now()) // Ürün oluşturulma tarihi
  updatedAt DateTime @updatedAt      // Ürün güncellenme tarihi
  orders    Order[]  // Siparişler ve ürünler arasındaki ilişki
}

// Order modelini oluşturuyoruz (Siparişler tablosu)
model Order {
  id        Int      @id @default(autoincrement()) // Benzersiz ID
  userId    Int      // Kullanıcı ID'si
  productId Int      // Ürün ID'si (foreign key)
  quantity  Int      // Sipariş edilen ürün miktarı
  createdAt DateTime @default(now()) // Sipariş oluşturulma tarihi
  updatedAt DateTime @updatedAt      // Sipariş güncellenme tarihi

  product   Product  @relation(fields: [productId], references: [id]) // Ürünle ilişki
}
duct  @relation(fields: [productId], references: [id]) // Ürünle ilişki

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         Int       @id @default(autoincrement())
  email      String    @unique
  password   String
  role       String    @default("ADMIN")
  businessId Int?
  createdAt  DateTime  @default(now())
  business   Business? @relation(fields: [businessId], references: [id])
}

model Business {
  id         Int        @id @default(autoincrement())
  name       String
  sector     String
  isApproved Boolean    @default(false)
  createdAt  DateTime   @default(now())
  users      User[]
  products   Product[]
  orders     Order[]
  customers  Customer[]
  sales      Sale[]
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  price       Float
  costPrice   Float?
  stock       Int      @default(0)
  businessId  Int
  createdAt   DateTime @default(now())
  business    Business @relation(fields: [businessId], references: [id])
  orders      Order[]
  sales       Sale[]
}

model Customer {
  id         Int      @id @default(autoincrement())
  name       String
  email      String?
  phone      String?
  businessId Int
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id])
  orders     Order[]
}

model Order {
  id         Int       @id @default(autoincrement())
  productId  Int
  businessId Int
  customerId Int?
  quantity   Int
  status     String    @default("PENDING")
  createdAt  DateTime  @default(now())
  product    Product   @relation(fields: [productId], references: [id])
  business   Business  @relation(fields: [businessId], references: [id])
  customer   Customer? @relation(fields: [customerId], references: [id])
}

model Sale {
  id          Int      @id @default(autoincrement())
  businessId  Int
  productId   Int?
  description String?
  quantity    Int      @default(1)
  unitPrice   Float    @default(0)
  unitCost    Float    @default(0)
  total       Float    @default(0)
  amount      Float    @default(0)
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  business    Business @relation(fields: [businessId], references: [id])
  product     Product? @relation(fields: [productId], references: [id])
}